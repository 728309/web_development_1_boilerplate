{
  "name": "docker-template/app",
  "type": "project",
  "require": {
    "nikic/fast-route": "^1.3",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-ctype": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

